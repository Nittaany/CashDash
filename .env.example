PORT=5001
MONGODB_URI=mongodb://localhost:27017/cashdash
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-min-32-chars
CLIENT_URL=http://localhost:3000,http://localhost:8080
NODE_ENV=development

# Proxy and cookie settings
TRUST_PROXY=1
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Client (Vite) - prefix with VITE_ to expose to browser
# Leave empty for relative /api calls (works with Vite proxy or Vercel rewrites)
VITE_API_URL=
