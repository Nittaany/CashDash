pipeline {
    agent any

    parameters {
        string(name: 'AWS_CREDENTIALS_ID', description: 'Jenkins AWS credentials ID')
        string(name: 'S3_BUCKET', description: 'Target S3 bucket')
        string(name: 'CLOUDFRONT_DIST_ID', description: 'CloudFront distribution ID')
    }

    environment {
        NODE_ENV = 'production'
        REGION = 'ap-south-1'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/Nittaany/CashDash.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install --legacy-peer-deps'
            }
        }

        stage('Build') {
            steps {
                sh 'CI=false npm run build' // bypass ESLint warnings in CI
            }
        }

        stage('Deploy to S3') {
            steps {
                withAWS(credentials: "${params.AWS_CREDENTIALS_ID}", region: "${REGION}") {
                    sh """
                        # Sync build folder to S3 bucket (no ACL, bucket ownership enforced)
                        aws s3 sync build/ s3://${params.S3_BUCKET}/ --delete
                        
                        # Optional: Invalidate CloudFront cache
                        aws cloudfront create-invalidation --distribution-id ${params.CLOUDFRONT_DIST_ID} --paths "/*"
                    """
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline finished.'
        }
        success {
            echo 'Deployment succeeded!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
