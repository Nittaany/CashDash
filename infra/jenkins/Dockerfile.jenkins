# Reconstructed reference: Jenkins controller with Node.js 22, npm, Git, and AWS CLI v2
# Documents the containerized Jenkins setup from the original AWS S3/CloudFront pipeline
#
# Usage:
#   docker build -f Dockerfile.jenkins -t cashdash-jenkins .
#   docker run -d -p 8080:8080 -p 50000:50000 -v jenkins_home:/var/jenkins_home cashdash-jenkins

FROM jenkins/jenkins:lts

USER root

# Install Git (usually present but ensure it's available)
RUN apt-get update && \
    apt-get install -y git && \
    rm -rf /var/lib/apt/lists/*

# Install Node.js 22 and npm
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/* && \
    node --version && npm --version

# Install AWS CLI v2 (architecture-aware for x86_64 and aarch64)
RUN apt-get update && apt-get install -y unzip curl && \
    ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then \
      curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"; \
    elif [ "$ARCH" = "aarch64" ]; then \
      curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" -o "awscliv2.zip"; \
    else \
      echo "Unsupported architecture: $ARCH" && exit 1; \
    fi && \
    unzip awscliv2.zip && \
    ./aws/install && \
    rm -rf awscliv2.zip aws && \
    rm -rf /var/lib/apt/lists/* && \
    aws --version

USER jenkins

# Skip initial setup wizard (configure via JCasC or manually)
ENV JAVA_OPTS="-Djenkins.install.runSetupWizard=false"
