# Required
PORT=5001
MONGODB_URI=mongodb://localhost:27017/cashdash
JWT_ACCESS_SECRET=your-32-char-secret-access-key-here
JWT_REFRESH_SECRET=your-32-char-secret-refresh-key-here
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development
TRUST_PROXY=1
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional: Resend mailer (emails work via mock transport without these)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=CashDash <onboarding@resend.dev>

# Optional: Email verification enforcement (default: false)
# REQUIRE_EMAIL_VERIFICATION=true
