# Required
PORT=5001
MONGODB_URI=mongodb://localhost:27017/cashdash
JWT_ACCESS_SECRET=your-32-char-secret-access-key-here
JWT_REFRESH_SECRET=your-32-char-secret-refresh-key-here
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development
TRUST_PROXY=1
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Resend mailer: mock transport is only used in development and tests.
# Production email delivery requires a valid Resend API key.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=CashDash <no-reply@your-verified-domain.com>
# APP_URL=https://your-frontend-domain.example

# Optional: Email verification enforcement (default: false; true in production)
# REQUIRE_EMAIL_VERIFICATION=true

# Optional Google/GitHub OAuth (configure each provider ID and secret together)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_STATE_SECRET=replace-with-a-random-secret-at-least-32-characters
